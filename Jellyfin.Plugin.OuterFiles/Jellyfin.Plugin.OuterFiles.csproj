<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Jellyfin.Plugin.OuterFiles</RootNamespace>
    <AssemblyName>Jellyfin.Plugin.OuterFiles</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="$(JellyfinVersion)">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Model" Version="$(JellyfinVersion)">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Jellyfin.Plugin.OuterFiles.Domain\Jellyfin.Plugin.OuterFiles.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Jellyfin.Plugin.OuterFiles.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Configuration\*.html" />
    <EmbeddedResource Include="Configuration\*.html" />
  </ItemGroup>

</Project>
