<Project>
  <!-- One version for every assembly. build.yaml carries the same value for jprm;
       VersionConsistencyTests fails the build when the two drift apart. -->
  <PropertyGroup>
    <Version>0.4.6.0</Version>
    <AssemblyVersion>0.4.6.0</AssemblyVersion>
    <FileVersion>0.4.6.0</FileVersion>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <AnalysisMode>Recommended</AnalysisMode>
    <WarningsAsErrors>nullable</WarningsAsErrors>
    <!-- CA1848/CA1873: LoggerMessage generators are noise for a handful of log lines. CA1822: services stay instance members for DI. -->
    <NoWarn>$(NoWarn);CA1848;CA1873;CA1822</NoWarn>
    <JellyfinVersion>12.4.0</JellyfinVersion>
  </PropertyGroup>
</Project>
